# Local development: copy to .env (do not commit it).
# Wrangler ignores .env when .dev.vars exists; use only one of them.

# Login: use a random secret locally; configure a separate secret in production.
AUTH_SECRET=replace-with-a-random-local-secret
# Local OTP mode: return the code in the response/UI and NEVER send an email.
# Keep unset or 0 in production. This is not a production login setting.
AUTH_EXPOSE_CODE=1

# TypeSafe (Jev) — required for the host to answer
TYPESAFE_API_KEY=apikey_xxx

# Puzzle generator — provide ONE of the following.
# DeepSeek (default provider when DEEPSEEK_API_KEY is set)
DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Any other OpenAI-compatible endpoint (overrides the above)
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=xxx
# LLM_MODEL=your-model

# Optional production email sender (Wrangler already has a default MAIL_FROM).
# MAIL_FROM=noreply@example.com
# Optional administrative generation/maintenance token; defaults to AUTH_SECRET.
# DAILY_ADMIN_TOKEN=replace-with-a-separate-secret
