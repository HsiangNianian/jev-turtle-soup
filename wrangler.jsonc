{
  // Cloudflare Workers config. The Worker serves /api/* and falls back to the
  // Vite build in ./dist for everything else.
  "name": "jev-turtle-soup",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
