{
  // Cloudflare Workers config. The Worker serves /api/* and falls back to the
  // Vite build in ./dist for everything else.
  "name": "jev-turtle-soup",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "AUTH_KV", "id": "9b14573349f24bcaa7a7688957406e3c" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jev-turtle-soup",
      "database_id": "16fe5cb2-8c9a-43a5-baa1-7dd911db327f"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "MAIL_FROM": "noreply@hgt.mmstudio.games"
  },
  "observability": {
    "enabled": true
  }
}
