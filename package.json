{
  "name": "jev-turtle-soup",
  "private": true,
  "version": "0.33.8",
  "type": "module",
  "workspaces": [
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev --local",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "lint": "oxlint src shared worker server tests packages mobile/app mobile/src scripts",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"shared/**/*.ts\" \"worker/**/*.ts\" \"server/**/*.ts\" \"*.{json,md}\"",
    "preview": "vite preview",
    "db:local": "wrangler d1 execute jev-turtle-soup --local --file=./db/schema.sql",
    "test": "vitest run",
    "wrangler": "wrangler",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "mobile:start": "npm run start --workspace @turtle-soup/mobile",
    "mobile:android": "node scripts/mobile/build.mjs android run",
    "mobile:ios": "node scripts/mobile/build.mjs ios run",
    "mobile:check": "npm run typecheck --workspace @turtle-soup/mobile && node scripts/mobile/check-boundaries.mjs && npm test",
    "mobile:export": "npm run export --workspace @turtle-soup/mobile",
    "mobile:fixture": "node scripts/mobile/fixture-api.mjs",
    "mobile:smoke:ios": "node scripts/mobile/smoke-ios.mjs",
    "mobile:smoke:android": "node scripts/mobile/smoke-android.mjs",
    "mobile:format": "prettier --write \"mobile/{app,src}/**/*.{ts,tsx}\" \"packages/client-core/src/**/*.ts\" \"scripts/mobile/*.mjs\"",
    "mobile:native:sync": "node scripts/mobile/build.mjs native sync",
    "mobile:build:android:debug": "node scripts/mobile/build.mjs android debug",
    "mobile:build:android:emulator": "node scripts/mobile/build.mjs android emulator",
    "mobile:build:android:preview": "node scripts/mobile/build.mjs android preview",
    "mobile:build:android:release": "node scripts/mobile/build.mjs android release",
    "mobile:build:ios:simulator": "node scripts/mobile/build.mjs ios simulator",
    "mobile:build:ios:development": "node scripts/mobile/build.mjs ios development",
    "mobile:build:ios:device": "node scripts/mobile/build.mjs ios device"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@typesafe-ai/sdk": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "openai": "^7.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "@turtle-soup/client-core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.136.2"
  }
}
